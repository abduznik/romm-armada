{
  "name": "romm-armada",
  "version": "0.3.1",
  "description": "RomM for Decky: download games to a dedicated folder and sync saves with argosy-sigil. Arm64 first.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "bash scripts/test-ui.sh"
  },
  "license": "MIT",
  "author": "abduznik",
  "dependencies": {
    "@decky/api": "1.1.3"
  },
  "devDependencies": {
    "@decky/rollup": "1.0.2",
    "@decky/ui": "4.11.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/webpack": "5.28.5",
    "esbuild": "^0.28.2",
    "jsdom": "26",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup": "4.62.0",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
